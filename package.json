{
  "name": "memento-viva",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "The Dual Gateway: A Día de los Muertos Living Ofrenda & Spectral Spirit Box powered by Gemma, Mastra, ElevenLabs, MongoDB Atlas, and Render",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mastra/core": "^0.24.9",
    "@sentry/node": "^11.10.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "mongodb": "^6.14.2",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
