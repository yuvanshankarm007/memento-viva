# ====================================================================
# MEMENTO VIVA - Environment Configuration
# Hacktoberfest 2026 Week 4: Ghost in the Machine
# Featuring Gemma, Mastra, ElevenLabs, MongoDB Atlas, and Render
# ====================================================================

# Port for the Express Agent backend
PORT=3001
NODE_ENV=development

# --- CATEGORY 1: GOOGLE GEMMA (Open-Weight Model) ---
# Mode options:
# 1) "ollama" - Runs locally using Ollama (e.g. `ollama run gemma2:2b` or `gemma2:9b`)
# 2) "huggingface" - Uses Hugging Face Inference API with `google/gemma-2-2b-it` or `google/gemma-2-9b-it`
# 3) "fallback" - Offline built-in procedural spirit & calavera generator (works 100% with no setup)
GEMMA_API_MODE=ollama
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL_NAME=gemma2:2b
HUGGINGFACE_API_KEY=hf_your_token_here

# --- CATEGORY 2: ELEVENLABS (Voice & Ethereal EVP Audio) ---
# Optional: If not provided, Memento Viva automatically uses Web Audio API
# procedural white noise, spectral frequency sweeps, and browser SpeechSynthesis!
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- CATEGORY 3: MONGODB ATLAS (Living Altar & Spirit Vault) ---
# Optional: Cloud MongoDB connection string for synchronizing user-created ofrendas,
# candles lit, and séance transcripts. If omitted, uses fast in-memory + local storage!
MONGODB_URI=
MONGODB_DB_NAME=memento_viva

# --- CATEGORY 4: SENTRY AGENT TRACING (Observability) ---
# Optional: Trace Mastra agent thoughts, token metrics, and latency
SENTRY_DSN=
